  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "711de3cd-b6e2-42e8-82cd-5287c85b2350"
      },
      "text": "let LatestIngestion = toscalar(\n    observations\n    | summarize max(ingested_at)\n);\nobservations\n| where ingested_at == LatestIngestion\n| project\n    Rank = ['rank'],\n    ShowTitle = ['title'],\n    Watchers = watcher_count,\n    ObservedAt = observed_at\n| order by Rank asc",
      "id": "feeff3bf-d9d5-4a0f-8194-58ff956b1920",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "711de3cd-b6e2-42e8-82cd-5287c85b2350"
      },
      "text": "let LatestTime = toscalar(\n    observations\n    | summarize max(ingested_at)\n);\nlet PreviousTime = toscalar(\n    observations\n    | where ingested_at < LatestTime\n    | summarize max(ingested_at)\n);\nlet CurrentSnapshot =\n    observations\n    | where ingested_at == LatestTime\n    | project\n        trakt_show_id,\n        ShowTitle = ['title'],\n        CurrentRank = ['rank'],\n        CurrentWatchers = watcher_count;\nlet PreviousSnapshot =\n    observations\n    | where ingested_at == PreviousTime\n    | project\n        trakt_show_id,\n        PreviousRank = ['rank'],\n        PreviousWatchers = watcher_count;\nCurrentSnapshot\n| join kind=leftouter PreviousSnapshot on trakt_show_id\n| extend\n    WatcherChange = CurrentWatchers - PreviousWatchers,\n    RankChange = PreviousRank - CurrentRank\n| top 10 by WatcherChange desc\n| project ShowTitle, CurrentRank, CurrentWatchers, WatcherChange, RankChange",
      "id": "bbfc5434-accb-4599-a058-2d7feeaa547d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "c501223d-0073-4e87-9298-74bc1223191e"
      },
      "text": "observations\n| summarize WatcherActivity = sum(watcher_count)\n    by TimeWindow = bin(ingested_at, 5m)\n| order by TimeWindow asc",
      "id": "1b254fbc-f4dc-4b69-9675-d9db1e0fdc3d",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "711de3cd-b6e2-42e8-82cd-5287c85b2350"
      },
      "text": "observations\n| summarize\n    TotalObservations = count(),\n    Collections = dcount(collection_id),\n    LastUpdated = max(ingested_at)",
      "id": "20caa78e-6083-4bcb-867f-58e14c68cfd8",
      "usedVariables": []
    }
